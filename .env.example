# StudyHack Backend — environment

PORT=8080
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Browser -> backend auth (Clerk). Doc 1 Decision 3.5 (Option B).
# Leave MOCK_AUTH=true for local dev to skip Clerk and attach a mock user.
MOCK_AUTH=true
CLERK_SECRET_KEY=

# Backend -> agent. Mocked until the agent service (studyhack-agent) is wired.
USE_MOCK_AGENT=true
AGENT_URL=
INTERNAL_JWT_SECRET=

# Postgres (Neon) + R2 — add when endpoints are implemented
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
